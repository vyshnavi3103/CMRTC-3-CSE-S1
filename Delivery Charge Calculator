public class Delivery {
    static int baseCharge = 50; 
    String customerName;
    int distanceInKm;

    Delivery(String name, int distance) {
        customerName = name;
        distanceInKm = distance;
    }
    int calculateDeliveryCharge() {
        int ratePerKm = 10;
        return baseCharge + (distanceInKm * ratePerKm);
    }

    void displayDetails() {
        System.out.println("Name : " + customerName);
        System.out.println("Distance : " + distanceInKm + " Km");
        System.out.println("Total Delivery Charge: " + calculateDeliveryCharge());
    }

    public static void main(String[] args) {
        Delivery customer1 = new Delivery("Arjun", 5);
        Delivery customer2 = new Delivery("Sneha", 10);
        customer1.displayDetails();
        customer2.displayDetails();
    }
}
