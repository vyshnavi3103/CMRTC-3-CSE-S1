public class WorkoutTracker {

    static final double MET_RUNNING = 9.8;
    static final double MET_CYCLING = 7.5;
    static final double MET_SWIMMING = 8.3;

    String userName;
    int age;
    double weight; 
    String workoutType;
    int duration; 

    WorkoutTracker(String userName, int age, double weight, String workoutType, int duration) {
        this.userName = userName;
        this.age = age;
        this.weight = weight;
        this.workoutType = workoutType;
        this.duration = duration;
    }

    double getMETValue() {
        switch (workoutType.toLowerCase()) {
            case "running":
                return MET_RUNNING;
            case "cycling":
                return MET_CYCLING;
            case "swimming":
                return MET_SWIMMING;
            default:
                return 0; 
        }
    }

    double calculateCaloriesBurned() {
        double metValue = getMETValue();
        double caloriesPerMinute = 0.0175 * metValue * weight;
        return caloriesPerMinute * duration;
    }


    void displaySummary() {"
        System.out.println("Workout: " + workoutType);
        System.out.println("Weight: " + weight + " kg");
        System.out.println("Duration: " + duration + " minutes");
        System.out.printf("Calories Burned: %.1f\n\n", calculateCaloriesBurned());
    }

    public static void main(String[] args) {
        WorkoutTracker user1 = new WorkoutTracker("Neha", 28, 60.0, "Running", 30);
        WorkoutTracker user2 = new WorkoutTracker("Raj", 35, 70.5, "Swimming", 45);

        user1.displaySummary();
        user2.displaySummary();
    }
}
